FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JOB_TIMEOUT_SECONDS=7200

WORKDIR /app

# Runtime tools only; model weights come from RunPod Cached Models.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Install the official Lightricks LTX-2 pipelines, but never download model weights here.
RUN git clone --depth 1 https://github.com/Lightricks/LTX-2.git /opt/LTX-2 && \
    python -m pip install --upgrade pip && \
    python -m pip install -e /opt/LTX-2/packages/ltx-pipelines

COPY requirements-ltx25.txt /app/requirements-ltx25.txt
RUN python -m pip install -r /app/requirements-ltx25.txt

COPY worker_ltx25.py /app/worker_ltx25.py
COPY handler_ltx25.py /app/handler.py

CMD ["python", "-u", "/app/handler.py"]
